{
  "name": "store",
  "version": "0.1.0",
  "description": "Self-hosted open-source store: storefront, admin, blog and checkout on Cloudflare Workers.",
  "type": "module",
  "scripts": {
    "dev": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "deploy": "npm --prefix web run deploy",
    "typecheck": "npm --prefix web run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:reclamation": "node web/scripts/verify-reclamation.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241205.0",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.2",
    "vitest": "^2.1.9"
  }
}
