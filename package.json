{
  "name": "store",
  "version": "0.1.0",
  "description": "Self-hosted open-source store: storefront, admin, blog and checkout on Cloudflare Workers.",
  "type": "module",
  "scripts": {
    "dev": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "deploy": "npm --prefix web run deploy",
    "typecheck": "npm --prefix web run typecheck && npm run typecheck:dom",
    "typecheck:dom": "node web/node_modules/typescript/bin/tsc --noEmit -p web/tsconfig.tests-dom.json",
    "typecheck:tests": "tsc -p tests --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:scale": "node scripts/test-scale.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:reclamation": "node web/scripts/verify-reclamation.mjs",
    "test:changed": "vitest run --changed",
    "test:file": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241205.0",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "sass-embedded": "^1.106.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^2.1.9"
  }
}
