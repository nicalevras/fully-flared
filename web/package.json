{
  "name": "store-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && tsc --noEmit",
    "preview": "vite preview",
    "setup": "wrangler types && wrangler d1 migrations apply store-db --local && wrangler d1 execute store-db --local --file=scripts/seed.sql",
    "migrate:local": "wrangler d1 migrations apply store-db --local",
    "migrate:remote": "wrangler d1 migrations apply store-db --remote",
    "bootstrap:owner": "node scripts/bootstrap-owner.mjs",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "check": "npm run build && wrangler types --check",
    "predeploy": "node scripts/validate-deploy.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "verify:http": "node scripts/verify-http.mjs",
    "verify:stock": "node scripts/verify-stock-sale.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth/drizzle-adapter": "^1.7.10",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@floating-ui/react": "^0.27.20",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@tanstack/react-table": "^9.3.1",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-find-and-replace": "^3.32.0",
    "@tiptap/extension-horizontal-rule": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "better-auth": "^1.7.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.61.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hotkeys-hook": "^5.3.3",
    "sanitize-html": "^2.17.6",
    "stripe": "^23.0.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/workers-types": "^5.20261016.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-start": "^1.169.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "json5": "2.2.3",
    "sass-embedded": "^1.106.1",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "^4.151.1"
  }
}
